{
  "name": "@fanny7d/ccursor",
  "version": "0.1.3",
  "description": "Cursor++ BYOK Installer \u2014 Bring Your Own Key for Cursor IDE",
  "type": "module",
  "bin": {
    "ccursor": "dist/cli.cjs"
  },
  "scripts": {
    "build": "node esbuild.js",
    "build:vsix": "node src/build-vsix.js",
    "build:all": "npm run build:vsix && npm run build",
    "test": "node --test test/*.test.mjs",
    "package:artifacts": "node src/package-artifacts.js"
  },
  "files": [
    "dist/",
    "vsix/"
  ],
  "keywords": [
    "cursor",
    "byok",
    "llm",
    "ai"
  ],
  "author": "CometixSpace",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.5",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fanny7d/CCursor.git",
    "directory": "installer"
  },
  "allowScripts": {
    "esbuild@0.28.0": true
  }
